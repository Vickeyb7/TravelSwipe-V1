{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with travel preferences and packing defaults",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "badge": { "type": "string" },
        "level": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Trip": {
      "title": "Trip",
      "description": "User travel itinerary and curated packing deck",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "destination": { "type": "string" },
        "region": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "durationNights": { "type": "number" },
        "durationDays": { "type": "number" },
        "travelersCount": { "type": "number" },
        "party": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "destination", "startDate", "endDate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Personal user profile and preferences"
    },
    "/users/{userId}/trips/{tripId}": {
      "schema": "Trip",
      "description": "Trips belonging to the authenticated user"
    }
  }
}
